{
  "forum_url": {
    "description": "论坛地址",
    "type": "string",
    "default": "https://bbs.mousebaoyan.cn"
  },
  "token": {
    "description": "论坛的 bot token",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true,
    "hint": "管理员在论坛后台的 bot 页创建，范围选 read、act、sync、auth、events；自动收录要建标签，再加 moderate。"
  },
  "platform_id": {
    "description": "用哪个 aiocqhttp 接入",
    "type": "string",
    "default": "",
    "hint": "接了多个 aiocqhttp 时填它的 ID，只有一个时留空。"
  },
  "sync_members": {
    "description": "同步群成员",
    "type": "bool",
    "default": true,
    "hint": "每小时把 NapCat 缓存里的成员名单推给论坛，进群、退群、改名片等随时推。关掉后论坛的成员名单不再更新，新群友登录不了。"
  },
  "login": {
    "description": "私聊登录",
    "type": "bool",
    "default": true,
    "hint": "群友私聊 bot 发“登录”或网页上的 6 位口令登录论坛。关掉后 bot 不理这些私聊。"
  },
  "push_bio": {
    "description": "推送 QQ 个性签名",
    "type": "bool",
    "default": true,
    "hint": "群友第一次登录论坛时，查他的 QQ 个性签名推给论坛。查签名要请求一次 QQ 服务器。"
  },
  "lottery": {
    "description": "开奖结果",
    "type": "object",
    "items": {
      "enabled": {
        "description": "开奖结果发到群里",
        "type": "bool",
        "default": true
      },
      "groups": {
        "description": "发到哪些群",
        "type": "list",
        "default": [],
        "hint": "填群号；空的发到主群。"
      }
    }
  },
  "archive": {
    "description": "自动收录",
    "type": "object",
    "items": {
      "enabled": {
        "description": "自动收录群里的提问和回答",
        "type": "bool",
        "default": false,
        "hint": "先配好下面的 OneJev、大模型和嵌入模型，用回放调好、在论坛上建好收录用的版块再打开（见仓库的 docs/replay.md）。"
      },
      "groups": {
        "description": "收录哪些群",
        "type": "list",
        "default": [],
        "hint": "填群号；空的收录论坛上关联的所有群。"
      },
      "notify": {
        "description": "收录后在群里 @ 发帖人",
        "type": "bool",
        "default": true,
        "hint": "收录了新帖子，或者提问并进了论坛上已有的帖子时，在群里 @ 他并附上帖子链接，一轮合成一条，每个群每小时最多 4 条。关掉后照常收录，bot 不在群里说话。"
      },
      "round_messages": {
        "description": "一轮最多几条消息",
        "type": "int",
        "default": 30,
        "hint": "攒够这么多条就交给模型判断。用回放调（docs/replay.md）。"
      },
      "round_minutes": {
        "description": "一轮最多等几分钟",
        "type": "float",
        "default": 10,
        "hint": "一轮的第一条消息之后过了这么久，不够条数也交给模型。要赶在 QQ 图片链接过期前转存，不要超过 60。"
      },
      "follow_messages": {
        "description": "跟进一个问题多少条消息",
        "type": "int",
        "default": 200,
        "hint": "问题最后一条相关消息之后，群里又过了这么多条，就不再跟进。"
      }
    }
  },
  "onejev": {
    "description": "OneJev（自动收录的初筛）",
    "type": "object",
    "items": {
      "url": {
        "description": "服务地址",
        "type": "string",
        "default": "http://127.0.0.1:8000",
        "hint": "连不上时收录暂停，不改用大模型。"
      },
      "api_key": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "服务没设密钥就留空。"
      },
      "model": {
        "description": "模型名称",
        "type": "string",
        "default": "jev-latest"
      },
      "threshold": {
        "description": "交给大模型的门槛",
        "type": "float",
        "default": 0.3,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "hint": "一轮里“有人提问”或“在回答跟进的问题”的概率到了这个数，才交给大模型整理。低了多花 token，高了会漏。用回放调。"
      }
    }
  },
  "llm": {
    "description": "大模型（自动收录的整理）",
    "type": "object",
    "items": {
      "base_url": {
        "description": "接口地址",
        "type": "string",
        "default": "https://chat.ecnu.edu.cn/open/api/v1",
        "hint": "OpenAI 兼容的地址，到 /v1 为止。插件直接调用，不经过 AstrBot 的模型配置：AstrBot 传不了结构化输出和思考参数。"
      },
      "api_key": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true
      },
      "model": {
        "description": "模型",
        "type": "string",
        "default": "ecnu-plus"
      },
      "structured_output": {
        "description": "结构化输出",
        "type": "string",
        "default": "json_schema",
        "options": [
          "json_schema",
          "json_object",
          "off"
        ],
        "hint": "json_schema：按插件给的格式约束输出，ECNU 的模型支持；json_object：只要求输出 JSON；off：不传，接口不支持 response_format 时用。"
      },
      "thinking": {
        "description": "思考模式",
        "type": "string",
        "default": "enabled",
        "options": [
          "enabled",
          "disabled",
          "omit"
        ],
        "hint": "enabled 开、disabled 关（ECNU 的 thinking 参数）；omit：不传，接口不认这个参数时用。"
      },
      "reasoning_effort": {
        "description": "思考程度",
        "type": "string",
        "default": "low",
        "options": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "hint": "只在开了思考时生效。ecnu-plus 可选 low、medium、xhigh；ecnu-max 可选 low、high、max。越高越慢、token 越多。"
      },
      "temperature": {
        "description": "温度",
        "type": "float",
        "default": 0.2,
        "slider": {
          "min": 0,
          "max": 2,
          "step": 0.1
        },
        "hint": "只在不思考时传；思考时用模型的默认值。"
      },
      "max_tokens": {
        "description": "每次最多输出多少 token",
        "type": "int",
        "default": 8192,
        "hint": "包括思考的部分。"
      },
      "timeout_seconds": {
        "description": "一次调用最多等几秒",
        "type": "int",
        "default": 300,
        "hint": "思考时白天的 ECNU 一次可能要两三分钟。超时的这一轮不再收录。"
      },
      "tokens_per_day": {
        "description": "每天最多用多少 token",
        "type": "int",
        "default": 1000000,
        "hint": "输入和输出合计。用完后当天不再整理，第二天恢复。0 不限。ECNU 每 7 天 2 万积分，ecnu-plus 输入每百万 token 100 积分、输出 400 积分，8–18 点翻倍。"
      }
    }
  },
  "embedding": {
    "description": "嵌入模型（自动收录的查重）",
    "type": "object",
    "items": {
      "base_url": {
        "description": "接口地址",
        "type": "string",
        "default": "http://127.0.0.1:11434/v1",
        "hint": "OpenAI 兼容的地址。默认是本机 Ollama；也可以用 ECNU 的 https://chat.ecnu.edu.cn/open/api/v1，模型填 ecnu-embedding-small（也是 bge-m3）。换模型后插件会重建帖子的向量索引。"
      },
      "api_key": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "Ollama 留空。"
      },
      "model": {
        "description": "模型",
        "type": "string",
        "default": "bge-m3"
      },
      "min_similarity": {
        "description": "语义相似的门槛",
        "type": "float",
        "default": 0.5,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "hint": "和新提问的相似度到这个数的帖子，才拿去让大模型判断是不是同一个问题。用回放调。"
      }
    }
  }
}
